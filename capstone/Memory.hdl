// File name: capstone/Memory.hdl
/**
 * The complete address space of the Hack computer's memory,
 * including RAM and memory-mapped I/O.
 */
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // address[14]==0 -> RAM16K (0..16383)
    // address[14]==1 && address[13]==0 -> Screen (16384..24575)
    // address[14]==1 && address[13]==1 -> Keyboard (24576)
    Not(in=address[14], out=isRam);
    And(a=address[14], b=address[13], out=isKbd);
    Not(in=address[13], out=notAddr13);
    And(a=address[14], b=notAddr13, out=isScreen);

    And(a=load, b=isRam, out=loadRam);
    And(a=load, b=isScreen, out=loadScreen);

    RAM16K(in=in, load=loadRam, address=address[0..13], out=ramOut);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);
    Keyboard(out=kbdOut);

    Mux16(a=screenOut, b=kbdOut, sel=isKbd, out=ioOut);
    Mux16(a=ramOut, b=ioOut, sel=address[14], out=out);
}
