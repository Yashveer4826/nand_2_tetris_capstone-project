// File name: capstone/CPU.hdl
/**
 * The Hack Central Processing unit (CPU).
 */
CHIP CPU {

    IN  inM[16],         // M value input  (M = contents of RAM[A])
        instruction[16], // Instruction for execution
        reset;           // Signals whether to re-start the current
                         // program (reset==1) or continue executing
                         // the current program (reset==0).

    OUT outM[16],        // M value output
        writeM,          // Write to M?
        addressM[15],    // Address in data memory (of M)
        pc[15];          // address of next instruction

    PARTS:
    // Decode instruction type: bit 15 == 0 -> A-instruction, bit 15 == 1 -> C-instruction
    Not(in=instruction[15], out=isA);
    Not(in=isA, out=isC);

    // Destination bits for C-instruction: d1=instruction[5] (A), d2=instruction[4] (D), d3=instruction[3] (M)
    And(a=isC, b=instruction[5], out=aluToA);
    And(a=isC, b=instruction[4], out=loadD);
    And(a=isC, b=instruction[3], out=writeM);

    // Input to ARegister: instruction (if A-instr) or aluOut (if C-instr with d1=1)
    Mux16(a=instruction, b=aluOut, sel=aluToA, out=aIn);
    Or(a=isA, b=aluToA, out=loadA);
    ARegister(in=aIn, load=loadA, out=aOut, out[0..14]=addressM);

    // ALU y-input: a-bit is instruction[12] (0 -> A, 1 -> inM)
    Mux16(a=aOut, b=inM, sel=instruction[12], out=aluY);

    // ALU execution
    ALU(
        x=dOut,
        y=aluY,
        zx=instruction[11],
        nx=instruction[10],
        zy=instruction[9],
        ny=instruction[8],
        f=instruction[7],
        no=instruction[6],
        out=aluOut,
        out=outM,
        zr=zr,
        ng=ng
    );

    // DRegister
    DRegister(in=aluOut, load=loadD, out=dOut);

    // Jump logic: j1=instruction[2] (<0), j2=instruction[1] (==0), j3=instruction[0] (>0)
    Or(a=zr, b=ng, out=leZero);
    Not(in=leZero, out=pos);

    And(a=instruction[2], b=ng, out=jlt);
    And(a=instruction[1], b=zr, out=jeq);
    And(a=instruction[0], b=pos, out=jgt);

    Or(a=jlt, b=jeq, out=jle);
    Or(a=jle, b=jgt, out=anyJumpCond);
    And(a=isC, b=anyJumpCond, out=doJump);

    // Program Counter
    Not(in=doJump, out=incPc);
    PC(in=aOut, load=doJump, inc=incPc, reset=reset, out[0..14]=pc);
}
